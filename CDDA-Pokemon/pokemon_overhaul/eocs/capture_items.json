  {
    "type": "effect_on_condition",
    "id": "EOC_PKMN_CAPTURE",
    "//": "u = target Pokémon, npc = thrower, _pkmn_ball = ball multiplier.",
    "effect": [
      {
        "math": [
          "_pkmn_done = 0"
        ]
      },
      {
        "if": {
          "math": [
            "u_val('friendly') != 0"
          ]
        },
        "then": [
          {
            "u_message": "<u_name> is already yours.  The ball bounces back and is lost in the brush.",
            "type": "neutral"
          },
          {
            "math": [
              "_pkmn_done = 1"
            ]
          }
        ]
      },
      {
        "if": {
          "and": [
            {
              "math": [
                "_pkmn_done == 0"
              ]
            },
            {
              "u_has_species": "PKMN_TRAINER_OWNED"
            }
          ]
        },
        "then": [
          {
            "u_message": "The trainer blocked the ball!  Don't be a thief!",
            "type": "bad"
          },
          {
            "math": [
              "_pkmn_done = 1"
            ]
          }
        ]
      },
      {
        "if": {
          "math": [
            "_pkmn_done == 0"
          ]
        },
        "then": [
          {
            "math": [
              "u_pkmn_level = value_or(u_pkmn_level, 5)"
            ]
          },
          {
            "math": [
              "_rate = u_has_flag('PKMN_CATCH_1') ? 80 : (u_has_flag('PKMN_CATCH_2') ? 45 : (u_has_flag('PKMN_CATCH_3') ? 22 : 4))"
            ]
          },
          {
            "math": [
              "_hp = 1 - 0.75 * u_hp('ALL') / max(1, u_hp_max('torso'))"
            ]
          },
          {
            "math": [
              "_status = 1"
            ]
          },
          {
            "if": {
              "or": [
                {
                  "u_has_effect": "pkmn_paralysis"
                },
                {
                  "u_has_effect": "pkmn_burn"
                },
                {
                  "u_has_effect": "pkmn_poison"
                },
                {
                  "u_has_effect": "stunned"
                }
              ]
            },
            "then": {
              "math": [
                "_status = 1.5"
              ]
            }
          },
          {
            "if": {
              "or": [
                {
                  "u_has_effect": "pkmn_sleep"
                },
                {
                  "u_has_effect": "pkmn_freeze"
                }
              ]
            },
            "then": {
              "math": [
                "_status = 2.2"
              ]
            }
          },
          {
            "math": [
              "_chance = clamp(_rate * _hp * _pkmn_ball * _status, 2, 100)"
            ]
          },
          {
            "if": {
              "math": [
                "rng(0, 100) <= _chance"
              ]
            },
            "then": {
              "run_eocs": "EOC_PKMN_CAPTURE_SUCCESS"
            },
            "else": {
              "run_eocs": "EOC_PKMN_CAPTURE_FAIL"
            }
          }
        ]
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PKMN_CAPTURE_SUCCESS",
    "effect": [
      {
        "math": [
          "u_val('friendly') = -1"
        ]
      },
      {
        "u_add_effect": "pet",
        "duration": "PERMANENT"
      },
      {
        "u_lose_effect": "pkmn_sleep"
      },
      {
        "u_lose_effect": "pkmn_freeze"
      },
      {
        "math": [
          "u_pkmn_xp = value_or(u_pkmn_xp, 0)"
        ]
      },
      {
        "run_eocs": "EOC_PKMN_APPLY_LEVEL"
      },
      {
        "run_eocs": {
          "id": "EOC_PKMN_GIVE_REGISTERED_BALL",
          "effect": {
            "u_spawn_item": "pkmn_ball_registered",
            "suppress_message": true
          }
        },
        "alpha_talker": "avatar"
      },
      {
        "math": [
          "pkmn_caught_total = value_or(pkmn_caught_total, 0) + 1"
        ]
      },
      {
        "u_message": "…1…2…3…  Click!  Gotcha!  <u_name> (level <u_val:pkmn_level>) was caught!  You receive its registered Poké Ball, used to recall it and send it back out.",
        "type": "good"
      }
    ]
  },
  {
    "type": "effect_on_condition",
    "id": "EOC_PKMN_CAPTURE_FAIL",
    "effect": [
      {
        "weighted_list_eocs": [
          [
            {
              "id": "EOC_PKMN_CAPTURE_FAIL_1",
