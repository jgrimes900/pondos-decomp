  {
    "type": "terrain",
    "id": "t_cave_moss",
    "name": "cave moss bed",
    "//": "Recreated from the BN version of the mod, where it lingers as an obsolete terrain.  Here it serves as the bed that cavern spores are sown into.",
    "description": "A sprawling bed of strange bluish moss, carefully spread over loosened stone and broken rock.  The spores of cavern growths could be sown here, and they'd be able to thrive without any sunlight at all.",
    "looks_like": "t_moss_underground",
    "symbol": ".",
    "color": "cyan",
    "move_cost": 2,
    "roof": "t_rock_roof",
    "connect_groups": "INDOORFLOOR",
    "flags": [ "TRANSPARENT", "DIGGABLE", "FLAT", "SUPPORTS_ROOF", "INDOORS" ],
    "bash": { "sound": "thump", "ter_set": "t_null", "str_min": 40, "str_max": 100, "str_min_supported": 100, "bash_below": true }
  },
