{
  "settings": {
    "//": "Stat scaling: every creature, weapon, armour and healing item says (default_max_health) what player max health its numbers were written for; when it is created, these props are converted to this world's player (the player's own default_max_health). So a mod that makes the player tougher doesn't leave everyone else's wolves toothless. Use scaled(n) or scaled(n, base) in expressions for literal amounts.",
    "stat_scaling": {"prop": "default_max_health", "default": 20, "props": ["health", "max_health", "damage", "armor", "heal", "charge"]}
  },

  "features": {
    "player": {
      "_patch": true,
      "props": {"default_max_health": 20, "health": 20, "max_health": 20, "attack": 1, "armor": 0}
    },
    "edible": {
      "_patch": true,
      "props": {"default_max_health": 20, "heal": 2}
    },

    "creature": {
      "abstract": true,
      "tags": ["creature"],
      "props": {
        "default_max_health": 20,
        "health": 6, "max_health": 6, "damage": 2, "armor": 0, "hostile": false,
        "attack_text": "attacks",
        "death_text": "{self.The} collapses and moves no more."
      },
      "actions": {
        "attack": [
          {"if": {"prop": "health", "lte": 0}, "do": ["{self.The} is already finished."]},
          {"do": [{"macro": "player_attacks"}]}
        ],
        "take": ["Not while it still has teeth."],
        "talk": [
          {"if": {"prop": "hostile"}, "do": ["{self.The} answers with a snarl."]},
          {"do": ["{self.The} regards you warily."]}
        ]
      },
      "on_enter": [
        {"if": {"prop": "hostile"}, "do": [{"say": "{self.The} turns toward you, ready to fight!", "style": "warn"}, {"interrupt": true}]}
      ],
      "on_turn": [
        {"if": {"all": [{"prop": "hostile"}, {"prop": "health", "gt": 0}]}, "do": [{"macro": "creature_attacks"}]}
      ]
    },
    "hostile": {
      "abstract": true,
      "extends": ["creature"],
      "tags": ["hostile"],
      "props": {"hostile": true}
    },

    "grey_wolf": {
      "extends": ["hostile"],
      "name": "grey wolf",
      "aliases": ["wolf"],
      "tags": ["encounter", "animal"],
      "habitat": ["forest", "hills"],
      "weight": 3,
      "appearance": "A grey wolf stands with its hackles raised, lips peeled back from yellow teeth.",
      "description": "Lean and hungry, all ribs and sinew. Its eyes never leave you.",
      "props": {"default_max_health": 20, "health": 8, "max_health": 8, "damage": 3, "attack_text": "bites", "death_text": "The wolf yelps once and lies still."},
      "on_death": [{"spawn": "wolf_pelt", "in": "room"}]
    },
    "wolf_pelt": {
      "extends": ["valuable"],
      "name": "wolf pelt",
      "aliases": ["pelt", "fur", "hide"],
      "props": {"default_max_health": 20, "value": 4, "armor": 1},
      "description": "A thick grey pelt. Worn over the shoulders it would turn a blow or two."
    },
    "bandit": {
      "extends": ["hostile"],
      "name": "#bandit_adj# bandit",
      "aliases": ["bandit", "robber", "thief", "outlaw", "highwayman"],
      "tags": ["encounter", "person"],
      "habitat": ["road", "forest"],
      "min_stage": 1,
      "appearance": "A {self.name} blocks the way, cudgel in hand. \"Your purse or your teeth!\"",
      "description": "Unwashed, unshaven and unfriendly.",
      "props": {"default_max_health": 20, "health": 10, "max_health": 10, "damage": 3, "armor": 1, "attack_text": "clubs", "death_text": "The bandit drops, groaning, and does not get up."},
      "features": [
        {"id": "cudgel"},
        {"id": "copper_coins", "chance": 0.7}
      ],
      "actions": {
        "give_with": [
          {"if": {"tag": "coin", "of": "target"}, "do": [{"destroy": "target"}, "The bandit snatches the coins, bites one, and slinks off into the undergrowth.", {"destroy": "self"}]}
        ]
      }
    },
    "cudgel": {
      "extends": ["portable"],
      "name": "knotted cudgel",
      "aliases": ["cudgel", "club"],
      "tags": ["weapon"],
      "props": {"default_max_health": 20, "damage": 2},
      "description": "A heavy length of blackthorn, studded with nails."
    },
    "adder": {
      "extends": ["hostile"],
      "name": "adder",
      "aliases": ["snake", "viper", "serpent"],
      "tags": ["encounter", "animal"],
      "habitat": ["hills", "marsh"],
      "appearance": "An adder lies coiled in the sun, tasting the air.",
      "description": "Zigzag markings along its back. It is not happy to see you.",
      "props": {"default_max_health": 20, "health": 3, "max_health": 3, "damage": 2, "attack_text": "strikes at"}
    },
    "bog_lurker": {
      "extends": ["hostile"],
      "name": "bog lurker",
      "aliases": ["lurker", "thing", "creature", "monster"],
      "tags": ["encounter", "monster"],
      "habitat": ["marsh", "eerie"],
      "min_stage": 1,
      "appearance": "Something heaves itself out of the mire: a bog lurker, dripping weed and black water.",
      "description": "A man-shaped heap of peat and roots with two pale lights for eyes.",
      "props": {"default_max_health": 20, "health": 14, "max_health": 14, "damage": 4, "armor": 1, "attack_text": "lashes", "death_text": "The bog lurker slumps back into the mire with a long sigh."},
      "on_death": [{"spawn": {"pick": ["lost_locket", "copper_coins", "rusty_sword"]}, "in": "room"}]
    },
    "giant_rat": {
      "extends": ["hostile"],
      "name": "giant rat",
      "aliases": ["rat"],
      "tags": ["encounter", "animal"],
      "habitat": ["dungeon", "ruins", "underground", "station", "interior"],
      "appearance": "A rat the size of a dog squeaks furiously at you.",
      "description": "Mangy, red-eyed and absolutely fearless.",
      "props": {"default_max_health": 20, "health": 4, "max_health": 4, "damage": 1, "attack_text": "gnaws"}
    },
    "rogue_drone": {
      "extends": ["hostile"],
      "name": "maintenance drone",
      "aliases": ["drone", "robot", "bot", "machine"],
      "tags": ["encounter", "machine"],
      "habitat": ["station", "scifi"],
      "appearance": "A maintenance drone hovers here, its welding arm sparking erratically. Its sensor light flicks red as it turns toward you.",
      "description": "A battered utility drone. Something has scrambled its safety protocols.",
      "props": {"default_max_health": 20, "health": 8, "max_health": 8, "damage": 3, "armor": 2, "attack_text": "zaps", "death_text": "The drone shudders, spits sparks, and clatters to the deck."},
      "on_death": [{"spawn": "power_cell", "in": "room"}]
    },
    "power_cell": {
      "extends": ["portable"],
      "name": "power cell",
      "aliases": ["cell", "battery"],
      "tags": ["power"],
      "description": "A palm-sized power cell, still warm. The charge light glows green."
    },

    "rusty_sword": {
      "extends": ["portable", "consumer"],
      "name": "rusty sword",
      "aliases": ["sword", "blade"],
      "tags": ["weapon", "scatter"],
      "habitat": ["dungeon", "ruins", "road", "ancient"],
      "props": {"default_max_health": 20, "damage": 3,
                "resource": "repair", "capacity": 12, "label": "edge", "on_empty": "transmute", "empty_into": "broken_sword",
                "depleted_text": "With a dull crack, the rusty sword's blade snaps off at the hilt."},
      "description": "Pitted with rust, but the edge will still bite. It won't for ever: a whetstone would help."
    },
    "broken_sword": {
      "extends": ["portable"],
      "name": "broken sword",
      "aliases": ["sword", "hilt", "broken sword"],
      "tags": ["weapon"],
      "props": {"default_max_health": 20, "damage": 1},
      "description": "A hilt and a hand's breadth of rusty blade. Better than your fists. Barely."
    },
    "whetstone": {
      "extends": ["supply"],
      "name": "whetstone",
      "aliases": ["whetstone", "stone", "hone"],
      "tags": ["scatter"],
      "habitat": ["road", "settlement", "ruins", "dungeon"],
      "props": {"repair": 8},
      "description": "A grey whetstone worn hollow in the middle. A few passes restore an edge (repair a blade with it)."
    },
    "short_bow": {
      "extends": ["portable", "consumer"],
      "name": "short bow",
      "aliases": ["bow", "short bow"],
      "tags": ["weapon", "scatter"],
      "habitat": ["forest", "hills", "road"],
      "props": {"default_max_health": 20, "damage": 4, "resource": "arrows", "feed": "direct", "label": "arrows",
                "empty_text": "You reach for an arrow and find none."},
      "description": "A hunter's bow of yew. It shoots arrows straight from whatever quiver you carry."
    },
    "quiver": {
      "extends": ["supply"],
      "name": "quiver of arrows",
      "aliases": ["quiver", "arrows", "arrow"],
      "tags": ["scatter"],
      "habitat": ["forest", "hills", "road", "settlement"],
      "props": {"arrows": 8},
      "description": "A leather quiver of goose-fletched arrows."
    },
    "firepot": {
      "extends": ["portable", "consumer"],
      "name": "firepot",
      "aliases": ["firepot", "pot", "fire pot", "bomb"],
      "tags": ["weapon", "scatter"],
      "habitat": ["ruins", "dungeon", "settlement", "station"],
      "props": {"default_max_health": 20, "damage": 7, "capacity": 1, "reloadable": false, "on_empty": "consume", "label": "throw",
                "depleted_text": "The firepot shatters in a sheet of flame."},
      "description": "A clay pot of pitch and oil with a rag fuse. You only get to throw it once."
    },
    "leather_jerkin": {
      "extends": ["portable"],
      "name": "leather jerkin",
      "aliases": ["jerkin", "armour", "armor", "leather"],
      "tags": ["scatter", "armour"],
      "habitat": ["road", "settlement", "ruins"],
      "props": {"default_max_health": 20, "armor": 1},
      "description": "Boiled leather, stiff and scuffed. It will turn a glancing blow."
    },
    "pipe_wrench": {
      "extends": ["portable"],
      "name": "heavy pipe wrench",
      "aliases": ["wrench", "spanner", "pipe"],
      "tags": ["weapon", "scatter"],
      "habitat": ["station", "scifi"],
      "props": {"default_max_health": 20, "damage": 3},
      "description": "Half a metre of steel. Built for bolts, good for a lot else."
    },
    "healing_salve": {
      "extends": ["edible"],
      "name": "pot of healing salve",
      "aliases": ["salve", "pot", "ointment", "balm"],
      "tags": ["scatter", "healing"],
      "habitat": ["settlement", "road", "ruins", "dungeon", "forest"],
      "props": {"default_max_health": 20, "heal": 10, "taste": "You smear it on your hurts rather than eating it, and feel the sting fade."},
      "description": "A little clay pot of green, herb-smelling salve."
    }
  },

  "verbs": {
    "attack": {
      "aliases": ["hit", "fight", "kill", "strike", "stab", "slash", "punch", "kick", "shoot", "smash", "slay"],
      "prepositions": ["with", "using"],
      "help": "attack <creature> [with <weapon>]",
      "default": [
        {"if": {"tag": "person", "of": "target"}, "do": ["{target.The} would not take kindly to that, and neither would anyone else."]},
        {"do": ["Attacking {target} achieves nothing."]}
      ]
    },
    "rest": {
      "aliases": ["sleep", "camp", "nap", "recover"],
      "target": "none",
      "time": 30,
      "help": "rest",
      "default": [
        {"if": {"here": {"prop": "hostile"}}, "do": ["You can't rest with enemies nearby!"]},
        {"if": "player.health >= player.max_health", "do": ["You aren't tired."]},
        {"do": [{"set": {"health": "=player.max_health"}, "on": "player"}, "You rest a while and wake refreshed. (Health: {player.health}/{player.max_health})"]}
      ]
    },
    "status": {
      "aliases": ["health", "hp", "stats", "condition"],
      "target": "none",
      "time": 0,
      "help": "status",
      "default": ["Health: {player.health}/{player.max_health}. Attack: {=player.attack + ready_damage(player)}. Armour: {=player.armor + best(player, 'armor')}."]
    }
  },

  "macros": {
    "player_attacks": {
      "do": [
        {"let": {"wpn": "=second.uid if second else best_weapon(player)"}},
        {"let": {"wdmg": "=wpn.damage if wpn else 0"}},
        {"if": {"exists": "local:wpn"}, "then": [{"spend": "local:wpn", "or_stop": true}]},
        {"let": {"dmg": "=max(1, player.attack + wdmg + rand(0, scaled(2)) - self.armor)"}},
        {"add": {"health": "=-dmg"}},
        {"if": {"exists": "local:wpn"}, "then": [{"deplete": "local:wpn"}]},
        {"set": {"hostile": true}},
        {"if": {"prop": "health", "lte": 0},
         "then": [
           {"say": "You strike {self} for {dmg} damage. {self.death_text}", "style": "good"},
           {"hook": "on_death"},
           {"for_each": {"tag": "portable"}, "in": "self", "hidden_too": true, "direct": true,
            "do": [{"reveal": "it"}, {"move": "it", "to": "room"}]},
           {"emit": "killed"},
           {"destroy": "self"}
         ],
         "else": ["You strike {self} for {dmg} damage. ({self.health}/{self.max_health})"]}
      ]
    },
    "creature_attacks": {
      "do": [
        {"let": {"hit": "=max(0, self.damage + rand(-scaled(1), scaled(1)) - player.armor - best(player, 'armor'))"}},
        {"if": {"local": "hit", "gt": 0},
         "then": [{"add": {"health": "=-hit"}, "on": "player"},
                  {"say": "{self.The} {self.attack_text} you for {hit} damage. (Health: {player.health}/{player.max_health})", "style": "warn"}],
         "else": ["{self.The} {self.attack_text} you, but you turn the blow aside."]},
        {"macro": "check_player_death"}
      ]
    },
    "check_player_death": {
      "do": [
        {"if": {"prop": "health", "of": "player", "lte": 0},
         "then": [{"end_game": "#death_line#"}]}
      ]
    }
  },

  "rules": {
    "combat_food_heals": {
      "on": ["ate", "drank"],
      "if": {"all": [{"prop": "heal", "of": "target", "gt": 0}, "player.health < player.max_health"]},
      "do": [
        {"add": {"health": "=min(target.heal, player.max_health - player.health)"}, "on": "player"},
        {"say": "You feel better. (Health: {player.health}/{player.max_health})", "style": "good"}
      ]
    },
    "combat_travel_regen": {
      "on": "travel",
      "if": "player.health < player.max_health and player.health > 0",
      "do": [{"add": {"health": "=min(scaled(1), player.max_health - player.health)"}, "on": "player"}]
    },
    "combat_count_kills": {
      "on": "killed",
      "do": [{"add_var": {"kills": 1}}]
    }
  },

  "grammar": {
    "bandit_adj": ["scarred", "one-eyed", "grinning", "ragged", "hulking", "wiry"],
    "death_line": [
      "Your strength fails you. The world narrows to a point of light, and then even that is gone.",
      "You fall, and do not rise. Somewhere, a story goes unfinished.",
      "Darkness takes you. Perhaps some other traveller will finish what you began."
    ]
  }
}
