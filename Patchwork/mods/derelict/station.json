      "rooms": {
        "cockpit": {
          "name": "Shuttle Cockpit",
          "aliases": [
            "cockpit",
            "shuttle",
            "ship"
          ],
          "tags": [
            "interior",
            "ship"
          ],
          "description": "The cramped cockpit of your shuttle, the Little Wren. Through the canopy, Station Kestrel looms: a spinning wheel of grey modules, all of its windows dark.",
          "brief": "Your shuttle's cockpit.",
          "features": [
            "comms_console",
            "pilot_seat",
            "emergency_locker"
          ],
          "exits": [
            {
              "to": "airlock",
              "dir": "aft",
              "distance": 1
            }
          ]
        },
        "airlock": {
          "name": "Docking Airlock",
          "aliases": [
            "airlock",
            "lock"
          ],
          "tags": [
            "interior",
            "station"
          ],
          "description": "A narrow airlock joining your shuttle to the station. The inner door's status light blinks green, then red, then green.",
          "brief": "The docking airlock.",
          "features": [
            {
              "name": "status light",
              "extends": [
                "scenery"
              ],
              "aliases": [
                "light",
                "status"
              ],
              "appearance": false,
              "description": "GREEN. RED. GREEN. It can't make up its mind."
            }
          ],
          "exits": [
            {
              "to": "bay",
              "dir": "aft",
              "distance": 1
            }
          ]
        },
        "bay": {
          "name": "Docking Bay",
          "aliases": [
            "bay",
            "docking bay",
            "hangar"
          ],
          "tags": [
            "interior",
            "station"
          ],
          "description": "A cavernous bay built for ore haulers. Your shuttle looks tiny in it. Cargo crates are stacked to the ceiling and a loader mech stands frozen mid-lift.",
          "brief": "The vast, silent docking bay.",
          "features": [
            "bay_terminal",
            "cargo_crates",
            "loader_mech"
          ]
        }
      }
    },
