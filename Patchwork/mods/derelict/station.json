          ]
        },
        {
          "name": "Mess Hall",
          "description": "Tables bolted to the deck, trays still on them. Whatever the crew were eating has long since gone grey.",
          "features": [
            {
              "name": "food dispenser",
              "extends": [
                "scenery"
              ],
              "aliases": [
                "dispenser",
                "machine"
              ],
              "appearance": "A food dispenser blinks a sad yellow light.",
              "description": "It offers SOY LOAF (PLAIN) and nothing else.",
              "actions": {
                "use": [
                  {
                    "if": {
                      "not": {
                        "flag": "got_soy"
                      }
                    },
                    "do": [
                      "The dispenser whirrs and drops a brick of soy loaf into the tray.",
                      {
                        "spawn": "soy_loaf",
                        "in": "room"
                      },
                      {
                        "flag": "got_soy"
                      }
                    ]
                  },
                  {
                    "do": [
                      "OUT OF STOCK, the display reads."
                    ]
                  }
                ],
                "push": [
                  "You thump it. It whirrs hopefully but produces nothing."
                ]
              }
            }
          ]
        },
        {
          "name": "Observation Lounge",
          "description": "A wide window looks out on the slow wheel of stars and, far below, the grey bulk of the asteroid the station was built to mine.",
          "features": [
            {
              "name": "viewport",
              "extends": [
                "scenery"
              ],
              "aliases": [
                "window",
                "stars",
                "asteroid"
              ],
              "appearance": false,
              "description": "Out there, nothing moves. In the reflection, something behind you does. When you turn, nothing is there."
            }
          ]
        }
      ]
    },
