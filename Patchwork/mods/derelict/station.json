  "beats": {
    "derelict_signal": {
      "title": "Answer the Signal",
      "stage": "opening",
      "tags": [
        "scifi"
      ],
      "area": "docking_ring",
      "intro": "The beacon repeats, patient as a heartbeat. Whoever sent it might still be alive.",
      "hint": "Board Station Kestrel and find out who sent the distress call. The docking bay terminal may have answers.",
      "objective": {
        "flag": "read_distress_log"
      },
      "complete_text": "So somebody is still alive in there. And somebody else, or something else, doesn't want them found.",
      "hook": "The docking logs mention {beat.area}."
    },
    "derelict_doctor": {
      "title": "Doctor's Orders",
      "stage": "middle",
      "tags": [
        "scifi"
      ],
      "area": "medbay",
      "provides": [
        "command_access"
      ],
      "roles": {
        "doctor": {
          "spawn": "station_doctor",
          "in": {
            "room": "ward"
          },
          "name": "Dr #scifi_given# #scifi_surname#"
        },
        "keycard": {
          "spawn": "command_keycard",
          "in": {
            "role": "doctor"
          },
          "hidden": true
        }
      },
      "intro": "The last crew log points to {beat.area}. If there are survivors, that's where they'll be.",
      "hint": "Find the survivors in {beat.area} and get the command keycard from {beat.doctor.name}.",
      "hook": "The survivors barricaded themselves in {beat.area}.",
      "rumor": [
        "Survivors moved to {beat.area}. Dr Okafor leading. Do NOT trust WARDEN.",
        "MEDBAY ->"
      ],
      "objective": {
        "has": "role:keycard"
      },
      "complete_text": "The keycard is warm from {beat.doctor.name}'s hand. Somewhere in the walls, WARDEN's fans spin up, as if it is paying attention."
    },
    "derelict_reactor": {
      "title": "Cold Fusion",
      "stage": "climax",
      "tags": [
        "scifi",
        "finale"
      ],
      "area": "reactor_deck",
      "needs": [
        "command_access"
      ],
      "gate": "A pressure door has sealed this passage. A screen beside it reads: SECTION LOCKED BY WARDEN.",
      "roles": {
        "coupling": {
          "find": {
            "tag": "fusion_coupling"
          },
          "spawn": "fusion_coupling",
          "in": {
            "region": "maintenance"
          }
        }
      },
      "intro": "With command access you can reach {beat.area}. Restart the reactor and the station lives. WARDEN will try to stop you.",
      "hint": "Find a fusion coupling (try the maintenance shafts), get through the blast door in {beat.area} and restart the reactor.",
      "hook": "Everything depends on getting the reactor in {beat.area} running again.",
      "rumor": [
        "Spare couplings got moved to the maintenance shafts before the lockdown. Bring one to {beat.area}.",
        "REACTOR = HOPE. COUPLINGS IN MAINTENANCE."
      ],
      "objective": {
        "flag": "reactor_restarted"
      },
      "complete_text": "The coupling locks home with a deep, satisfying clunk. For a second nothing happens. Then light runs up the reactor like fire up a fuse, and the whole station shivers awake."
    }
  },
  "premises": {
    "dead_signal": {
      "title": "Dead Signal",
      "menu_name": "Dead Signal (science fiction)",
      "tags": [
        "scifi"
      ],
      "beat_tags": [
        "scifi"
      ],
      "structure": [
        "opening",
        "middle*",
        "climax"
      ],
      "start_area": "docking_ring",
      "intro": "Ninety-one days out from anywhere, your salvage shuttle picks up a distress beacon: Station Kestrel, a deep-space mining platform, all hands, on repeat.\n\nYou are {var.player_name}, salvage pilot. You were only supposed to be passing through. But nobody else is close enough to answer, and so you dock.",
      "ending": "The Little Wren pulls away from Station Kestrel with eleven survivors packed into a hold built for four. Behind you, the station's windows glow one by one, lit and warm and alive. WARDEN has gone quiet. You intend to keep it that way.",
      "inventory": [
        {
          "name": "salvage multitool",
          "extends": [
            "portable"
          ],
          "aliases": [
            "multitool",
            "tool"
          ],
          "description": "Cutter, driver, scanner, bottle opener."
        }
      ],
      "strict": true
    }
  },
  "rules": {
    "warden_speaks": {
      "on": "enter",
      "if": {
        "all": [
          {
            "chance": 0.2
          },
          {
            "in_room": "tag:station"
          },
          {
            "not": {
              "flag": "reactor_restarted"
            }
          }
        ]
      },
      "do": [
        {
          "say": "#warden_line#",
          "style": "warn"
        }
      ]
    }
  }
